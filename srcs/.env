# -------------- Volumes --------------
WP_DATA_HOST=
WP_DATA_CONTAINER=/var/www/html

# -------------- Maria database --------------
MARIADB_USER_NAME=liri
MARIADB_DATABASE_NAME=wordpress
MARIADB_HOST=mariadb

# -------------- WordPress --------------
MARIADB_DATABASE_NAME: wordpress
WORDPRESS_URL: http://localhost:8080
WORDPRESS_TITLE: Wordpress
WORDPRESS_ADMIN_USER_NAME: boss
WORDPRESS_ADMIN_EMAIL: root@example.com
WORDPRESS_AUTHER_NAME: ali
WORDPRESS_AUTHER_EMAIL: liri@example.com
WORDPRESS_PATH: ${WP_DATA_CONTAINER}


# -------------- Redis ------------
REDIS_PORT=6379
REDIS_HOST=redis

DOMAIN_NAME=localhost

# -------------- FTP ------------
FTP_DIRECTORY: ${WP_DATA_CONTAINER}
FTP_USERNAME: liri
